{
  "model": "CTFT",
  "schema_version": "3.0",
  "collection": "playbooks",
  "tactic": "CTFT-TA-FOR",
  "items": [
    {
      "id": "CTFTCTE-FOR-001",
      "schema_version": "3.0",
      "name": "Recover the legitimate file signature",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-001",
      "triggers": {
        "all_of": [
          "IND-FOR-magic-mismatch"
        ],
        "any_of": [
          "IND-FOR-ext-type-conflict",
          "IND-FOR-file-cmd-unknown"
        ],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-raw-bytes",
          "desc": "Raw file available for byte inspection"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "true_type": {
            "type": "string"
          },
          "patched_file": {
            "type": "string"
          }
        },
        "required": [
          "true_type"
        ]
      },
      "steps": [
        {
          "id": "s1-detect",
          "action": "Compare leading bytes against a signature table.",
          "tool": "TOOL-xxd",
          "produces": [
            "observed_magic"
          ],
          "validates": "observed_magic != expected(declared_ext)",
          "on_true": "s2-identify",
          "on_false": "s3-fallback"
        },
        {
          "id": "s2-identify",
          "action": "Identify true type from internal structure/footers.",
          "tool": "TOOL-binwalk",
          "produces": [
            "true_type"
          ],
          "on_true": "s3-patch"
        },
        {
          "id": "s3-patch",
          "action": "Patch header to the true signature.",
          "tool": "TOOL-python-struct",
          "produces": [
            "patched_file"
          ],
          "success_when": "file(patched_file) == true_type"
        }
      ],
      "priority": 8,
      "cost": "low",
      "automation": "full",
      "confidence_prior": 0.75,
      "false_positives": [
        "Polyglot files legitimately carry two valid signatures."
      ],
      "success_criteria": "Recovered file opens as its true type and yields the next artifact.",
      "fallbacks": [
        "CTFTCTE-FOR-002",
        "CTFTCTE-STE-001"
      ],
      "tools": [
        "TOOL-xxd",
        "TOOL-file",
        "TOOL-binwalk",
        "TOOL-python-struct"
      ],
      "references": [
        "https://www.garykessler.net/library/file_sigs.html"
      ],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-002",
      "schema_version": "3.0",
      "name": "Carve hidden files from slack/unallocated space",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-002",
      "triggers": {
        "all_of": [],
        "any_of": [
          "IND-FOR-abnormal-eof-size"
        ],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-image",
          "desc": "Disk/file image available"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "carved_files": {
            "type": "array"
          }
        }
      },
      "steps": [
        {
          "id": "s1-scan",
          "action": "Scan for embedded signatures beyond declared structure end.",
          "tool": "TOOL-binwalk",
          "produces": [
            "embedded_files"
          ],
          "on_true": "s2-extract"
        },
        {
          "id": "s2-extract",
          "action": "Extract carved regions and inspect.",
          "tool": "TOOL-binwalk",
          "produces": [
            "carved_files"
          ],
          "success_when": "len(carved_files) > 0"
        }
      ],
      "priority": 6,
      "cost": "medium",
      "automation": "assisted",
      "confidence_prior": 0.6,
      "false_positives": [
        "Compression artifacts can look like embedded files."
      ],
      "success_criteria": "A carved file contains the flag or next stage.",
      "fallbacks": [
        "CTFTCTE-FOR-005"
      ],
      "tools": [
        "TOOL-binwalk"
      ],
      "references": [],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-005",
      "schema_version": "3.0",
      "name": "Recover secrets from a memory image",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-005",
      "triggers": {
        "all_of": [
          "IND-FOR-memory-image"
        ],
        "any_of": [],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-dump",
          "desc": "RAM image available"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "secrets": {
            "type": "array"
          }
        }
      },
      "steps": [
        {
          "id": "s1-triage",
          "action": "Enumerate processes and open handles.",
          "tool": "TOOL-volatility3",
          "produces": [
            "processes"
          ],
          "on_true": "s2-hunt"
        },
        {
          "id": "s2-hunt",
          "action": "Dump suspect process memory / scan for flag-like strings.",
          "tool": "TOOL-volatility3",
          "produces": [
            "secrets"
          ],
          "success_when": "len(secrets) > 0"
        }
      ],
      "priority": 7,
      "cost": "high",
      "automation": "assisted",
      "confidence_prior": 0.65,
      "false_positives": [
        "Profile mismatch yields empty output — not proof the secret is absent."
      ],
      "success_criteria": "Flag string recovered from a process/region.",
      "fallbacks": [
        "CTFTCTE-FOR-017"
      ],
      "tools": [
        "TOOL-volatility3",
        "TOOL-strings"
      ],
      "references": [],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-006",
      "schema_version": "3.0",
      "name": "Reassemble and decode hidden network payloads",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-006",
      "triggers": {
        "all_of": [
          "IND-FOR-pcap"
        ],
        "any_of": [],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-pcap",
          "desc": "Packet capture available"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "payloads": {
            "type": "array"
          }
        }
      },
      "steps": [
        {
          "id": "s1-proto",
          "action": "Break down protocol hierarchy, spot anomalies.",
          "tool": "TOOL-wireshark",
          "produces": [
            "streams"
          ],
          "on_true": "s2-follow"
        },
        {
          "id": "s2-follow",
          "action": "Follow streams / extract fields, decode payloads.",
          "tool": "TOOL-wireshark",
          "produces": [
            "payloads"
          ],
          "success_when": "flag_pattern in payloads"
        }
      ],
      "priority": 7,
      "cost": "medium",
      "automation": "assisted",
      "confidence_prior": 0.6,
      "false_positives": [
        "Encrypted TLS may need a key from another challenge stage."
      ],
      "success_criteria": "Decoded payload contains the flag.",
      "fallbacks": [],
      "tools": [
        "TOOL-wireshark"
      ],
      "references": [],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-010",
      "schema_version": "3.0",
      "name": "Retrieve information from QR / 2D barcodes",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-010",
      "triggers": {
        "all_of": [
          "IND-FOR-qr-visual"
        ],
        "any_of": [],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-image",
          "desc": "Image available"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "decoded_text": {
            "type": "string"
          }
        }
      },
      "steps": [
        {
          "id": "s1-decode",
          "action": "Decode the barcode symbol.",
          "tool": "TOOL-zbarimg",
          "produces": [
            "decoded_text"
          ],
          "success_when": "decoded_text != ''"
        }
      ],
      "priority": 9,
      "cost": "low",
      "automation": "full",
      "confidence_prior": 0.85,
      "false_positives": [
        "Damaged/partial codes may need reconstruction first."
      ],
      "success_criteria": "Decoded text is or reveals the flag.",
      "fallbacks": [],
      "tools": [
        "TOOL-zbarimg"
      ],
      "references": [],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-017",
      "schema_version": "3.0",
      "name": "Recover text data strings from ELF binary",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-017",
      "triggers": {
        "all_of": [
          "IND-FOR-embedded-strings"
        ],
        "any_of": [
          "IND-FOR-elf-binary"
        ],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-binary",
          "desc": "Binary available"
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "ascii_strings": {
            "type": "array"
          }
        }
      },
      "steps": [
        {
          "id": "s1-strings",
          "action": "Extract printable strings (raise -n to cut noise).",
          "tool": "TOOL-strings",
          "produces": [
            "ascii_strings"
          ],
          "success_when": "flag_pattern in ascii_strings"
        }
      ],
      "priority": 9,
      "cost": "low",
      "automation": "full",
      "confidence_prior": 0.7,
      "false_positives": [
        "Flag may be split/xored across sections — strings alone may miss it."
      ],
      "success_criteria": "A recovered string matches the flag format.",
      "fallbacks": [
        "CTFTCTE-FOR-001"
      ],
      "tools": [
        "TOOL-strings"
      ],
      "references": [],
      "domain": "FOR",
      "role": "resolution"
    },
    {
      "id": "CTFTCTE-FOR-018",
      "schema_version": "3.0",
      "name": "Analyze orphaned MFT records and raw attributes",
      "tactic": "CTFT-TA-FOR",
      "counters": "CTFTTE-FOR-018",
      "triggers": {
        "all_of": [
          "IND-FOR-mft-record-inconsistency"
        ],
        "any_of": [
          "IND-FOR-unlinked-mft-record"
        ],
        "none_of": []
      },
      "preconditions": [
        {
          "id": "have-readonly-ntfs-image",
          "desc": "A read-only NTFS image or documented MFT extract is available."
        }
      ],
      "inputs": {
        "type": "object",
        "properties": {
          "image_ref": {
            "type": "string"
          }
        },
        "required": [
          "image_ref"
        ]
      },
      "outputs": {
        "type": "object",
        "properties": {
          "record_findings": {
            "type": "array"
          },
          "correlated_artifacts": {
            "type": "array"
          }
        }
      },
      "steps": [
        {
          "id": "s1-inventory",
          "action": "Inventory records and retain the source reference.",
          "tool": "TOOL-mft-analysis",
          "produces": [
            "record_findings"
          ],
          "on_true": "s2-correlate"
        },
        {
          "id": "s2-correlate",
          "action": "Correlate unlinked records with allocation and directory evidence.",
          "tool": "TOOL-mft-analysis",
          "produces": [
            "correlated_artifacts"
          ],
          "success_when": "correlated_artifacts is not empty"
        }
      ],
      "priority": 7,
      "cost": "high",
      "automation": "assisted",
      "confidence_prior": 0.45,
      "false_positives": [
        "An unlinked record can be normal filesystem history; corroborating allocation evidence is required."
      ],
      "success_criteria": "A recovered artifact is linked to reproducible record and allocation evidence.",
      "fallbacks": [
        "CTFTCTE-FOR-002"
      ],
      "tools": [
        "TOOL-mft-analysis"
      ],
      "references": [
        "https://learn.microsoft.com/windows/win32/devnotes/master-file-table",
        "https://www.sleuthkit.org/"
      ],
      "domain": "FOR",
      "role": "resolution"
    }
  ]
}
