{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctft/schemas/technique.schema.json",
  "title": "CTFT Technique (design/hide)",
  "type": "object",
  "required": ["id", "schema_version", "name", "tactic", "paired_counter", "indicators"],
  "properties": {
    "id": { "type": "string", "pattern": "^CTFTTE-[A-Z]{3}-[0-9]{3}$" },
    "schema_version": { "const": "2.0" },
    "name": { "type": "string" },
    "tactic": { "type": "string", "pattern": "^CTFT-TA-[A-Z]{3}$" },
    "category": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "paired_counter": { "type": "string", "pattern": "^CTFTCTE-[A-Z]{3}-[0-9]{3}$" },
    "summary": { "type": "string" },
    "artifact_types": { "type": "array", "items": { "type": "string" } },
    "attack_complement": {
      "type": "object",
      "deprecated": true,
      "description": "Legacy single closest-technique prose. Superseded by attack_related (per-entry MITRE ATT&CK display, SCHEMA_V2 §3.5).",
      "properties": { "closest": { "type": "string" }, "note": { "type": "string" } }
    },
    "attack_related": {
      "type": "array",
      "description": "MITRE ATT&CK techniques potentially related to this entry; rendered on the technique page as a Related MITRE ATT&CK table.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "name": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "indicators": { "type": "array", "items": { "type": "string", "pattern": "^IND-" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "prevalence": { "type": "number", "minimum": 0, "maximum": 1 },
    "references": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
