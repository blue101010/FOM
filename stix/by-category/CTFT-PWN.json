    {
      "type": "attack-pattern",
      "spec_version": "2.1",
      "id": "attack-pattern--fc354b0f-dc89-5016-9d35-0cb18b9df0b5",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTTE-PWN-011 - Argument-gated target function",
      "description": "The sensitive routine (flag print, shell spawn, privileged call) validates its arguments — equality against constants, value ranges, or pointer identity — and bails out otherwise. A saved-return-address overwrite alone lands in the bail-out path: the solver must also place the expected values in the argument registers (rdi, rsi, rdx on x86-64; stack on i386), turning a one-gadget redirect into a register-setting problem. The required gadgets may be planted in the binary or must be hunted anywhere in the image or libc.",
      "kill_chain_phases": [
        {
          "kill_chain_name": "ctft",
          "phase_name": "pwn"
        }
      ],
      "x_ctft_category": "PWN",
      "x_ctft_domain": "PWN",
      "x_ctft_role": "design-hide",
      "external_references": [
