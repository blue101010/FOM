    {
      "type": "course-of-action",
      "spec_version": "2.1",
      "id": "course-of-action--432e9a83-f7a1-50d3-85b5-ab7446893a35",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTCTE-PWN-012 - Compute the target address from the leaked pointer",
      "description": "Parse the printed pointer, identify what it points at (stack slot or named global via the decompiler), then compute: PIE target = leaked address + (symbol − leaked symbol) from the static image; stack target = leaked stack address + fixed delta observed in GDB. Chain the computed address into the overflow payload.",
      "x_ctft_category": "PWN",
