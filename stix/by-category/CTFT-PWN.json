    {
      "type": "attack-pattern",
      "spec_version": "2.1",
      "id": "attack-pattern--5f1b016c-6c51-5dea-bf56-8525a93ad0f4",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTTE-PWN-010 - Archive hierarchy-reconstruction path traversal",
      "description": "The extractor rebuilds a directory tree in memory from archive entries: each parsed entry is attached to a previously seen node whose stored path matches the entry's parent directory, and orphans are re-parented under the root. At write time it joins output + stored-parent-path + name without sanitising the stored path. A single entry carrying ../ looks harmless (it becomes a root child with a weird name), but a crafted sibling pair — a directory entry ../../../root/.ssh followed by a file entry whose parent portion exactly matches that stored path — makes the tree hold a traversing parent path, so the final join writes outside the extraction root with the privileged process's rights. The archive passes naive \"no absolute paths, no symlinks\" validation and extracts without a single error message.",
      "kill_chain_phases": [
        {
          "kill_chain_name": "ctft",
          "phase_name": "pwn"
        }
      ],
      "x_ctft_category": "PWN",
      "x_ctft_domain": "PWN",
      "x_ctft_role": "design-hide",
      "external_references": [
        {
          "source_name": "ctft",
          "external_id": "CTFTTE-PWN-010"
        },
        {
          "source_name": "mitre-attack",
          "external_id": "T1190",
          "description": "Exploit Public-Facing Application"
        }
      ]
    },
    {
      "type": "course-of-action",
      "spec_version": "2.1",
      "id": "course-of-action--c130467e-aee9-5dde-9382-9d018542918f",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTCTE-PWN-010 - Craft sibling entries whose reconstructed parent path traverses",
      "description": "1. Reverse (or read, if source is recoverable) the parser's parenting rule: which stored node path must a later entry's parent portion match for the child to attach to it. 2. Craft a sibling pair per target file: first a directory entry whose path is <traversal-prefix><target-dir>, then a file entry whose path is <traversal-prefix><target-dir>/<name>. The traversal prefix must absorb the output folder depth (e.g. ../../../root/.ssh then ../../../root/.ssh/authorizedkeys for a one-level extracted folder). 3. Extract with the privileged tool and verify the write landed outside the output root; then aim the pair at a privileged target (authorizedkeys, cron files, a SUID launcher). 4. Count the ../ components from the observed write location — an off-by-one prefix fails silently inside the extraction folder.",
      "x_ctft_category": "PWN",
      "x_ctft_domain": "PWN",
      "x_ctft_role": "resolution",
      "external_references": [
        {
          "source_name": "ctft",
          "external_id": "CTFTCTE-PWN-010"
        },
        {
          "source_name": "mitre-attack",
          "external_id": "T1190",
          "description": "Exploit Public-Facing Application"
        }
      ]
    },
