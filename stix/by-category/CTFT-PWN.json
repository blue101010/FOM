    {
      "type": "attack-pattern",
      "spec_version": "2.1",
      "id": "attack-pattern--9ac12558-edfb-5bed-8653-108bbce390ac",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTTE-PWN-009 - Fixed-name output symlink redirect",
      "description": "A privileged helper (SUID binary, root-owned service) writes its results to a hard-coded, predictable relative path such as ./extracted, created relative to the caller's current working directory. The bug is not a memory corruption but a filesystem redirect: any user can pre-plant a symlink with that fixed name pointing anywhere on the filesystem, and the privileged process follows it when creating the directory or writing files through it. The flag is never reachable directly — the player is steered toward reverse-engineering the binary while the actual win condition is a two-line symlink plus a crafted archive.",
      "kill_chain_phases": [
        {
          "kill_chain_name": "ctft",
          "phase_name": "pwn"
        }
      ],
      "x_ctft_category": "PWN",
      "x_ctft_domain": "PWN",
      "x_ctft_role": "design-hide",
      "external_references": [
        {
