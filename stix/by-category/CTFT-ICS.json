          "external_id": "CTFTTE-ICS-006"
        },
        {
          "source_name": "mitre-attack",
          "external_id": "T0859",
          "description": "Valid Accounts"
        }
      ]
    },
    {
      "type": "course-of-action",
      "spec_version": "2.1",
      "id": "course-of-action--377838a0-407c-5542-88a6-c3c96a492e31",
      "created": "2026-06-10T18:01:52.000Z",
      "modified": "2026-06-10T18:01:52.000Z",
      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTCTE-ICS-006 - Read the device label and vendor documentation for default credentials",
      "description": "Identify the exact model from the label, the HMI banner or the service fingerprints, then read its vendor documentation for the default account policy. Check every physical surface of the challenge — device photos, printed labels, handouts — for the password and MAC address. Expect the same credential to unlock both the web-based manager and SSH, and reuse it on every exposed service.",
      "x_ctft_category": "ICS",
      "x_ctft_domain": "ICS",
      "x_ctft_role": "resolution",
      "external_references": [
