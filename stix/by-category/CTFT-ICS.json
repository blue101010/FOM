      "created_by_ref": "identity--930a2431-32e6-5652-ae5b-e36316353d39",
      "name": "CTFTTE-ICS-006 - Physical controller-label default credentials",
      "description": "The controller is the entry point of the whole track, but its credentials are never handed out: the default password is printed on the device label, next to the MAC address, and the same password unlocks both the web-based manager and SSH. A physical view of the controller — a photo, a label on the table of the SCADA village, the vendor datasheet for the exact model — is part of the intended reconnaissance.",
      "kill_chain_phases": [
        {
          "kill_chain_name": "ctft",
          "phase_name": "ics"
        }
      ],
      "x_ctft_category": "ICS",
      "x_ctft_domain": "ICS",
      "x_ctft_role": "design-hide",
      "external_references": [
